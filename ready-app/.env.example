# ---------------------------------------------------------------------------
# AI provider (optional, but this is what makes the outfit check real)
# ---------------------------------------------------------------------------
# Without a key the app runs in DEMO ANALYSIS mode: every screen that would
# show model output is labelled "Demo Analysis" and the outfit verdict is
# derived from on-device measurements only. Nothing is ever presented as a
# real wardrobe judgement when no model has looked at the frame.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Vision-capable model used for the appearance/environment read.
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Only needed behind a custom domain; localhost is detected automatically.
# PUBLIC_BASE_URL=http://localhost:4400

# ---------------------------------------------------------------------------
# Future integrations — the code has the seams, these turn them on.
# ---------------------------------------------------------------------------
# Weather-aware advice (lib/integrations/weather.ts). Left blank, the app never
# asks for location and never mentions the weather.
# OPENWEATHER_API_KEY=
