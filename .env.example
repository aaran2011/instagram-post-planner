# ─── Instagram Planner configuration ──────────────────────────────────────
# Local dev: copy to `.env.local`. Production (Vercel): add these in the
# Vercel dashboard → Project → Settings → Environment Variables.
# The app runs fully in DEMO MODE with none of the Instagram/AI values set.

# ── Your login (single user) ──────────────────────────────────────────────
APP_EMAIL=you@example.com
APP_PASSWORD=change-this-password
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Defaults ───────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Kolkata
DEMO_MODE=false

# ── AI (optional) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Instagram API with Instagram Login (no Facebook Page needed) ───────────
# From your Meta app → Instagram → "API setup with Instagram login":
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match a "Valid OAuth Redirect URI" in the app. On Vercel this is:
#   https://<your-app>.vercel.app/api/instagram/callback
INSTAGRAM_REDIRECT_URI=https://your-app.vercel.app/api/instagram/callback

# Only needed for the LOCAL (disk) setup so Instagram can fetch your media via
# a tunnel. On Vercel, media is served from Vercel Blob and this is NOT needed.
PUBLIC_BASE_URL=

# ── Production storage (Vercel) ────────────────────────────────────────────
# Vercel Blob: added automatically when you create a Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=
# Upstash Redis (free): create a DB at upstash.com and copy these two.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Scheduler ──────────────────────────────────────────────────────────────
# Secret so an external cron (cron-job.org) can call /api/scheduler/tick?key=...
SCHEDULER_KEY=
